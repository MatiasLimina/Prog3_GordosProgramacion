  <coordinates><x>350</x><y>450</y><w>240</w><h>120</h></coordinates>
  <panel_attributes>/Persona/
--
- numSeguridadSocial: String
- nombre: String
- direccion: String
- telefono: String
--
</panel_attributes>
</element>

<element>
  <id>UMLClass</id>
  <coordinates><x>50</x><y>650</y><w>260</w><h>130</h></coordinates>
  <panel_attributes>Mecanico
--
- salario: double
