--
- fechaAdquisicion: LocalDate
- propietario: Propietario
- avion: Avion
--
</panel_attributes>
</element>

<!-- Relations for inheritance -->
<element>
  <id>Relation</id>
  <coordinates><x>150</x><y>560</y><w>300</w><h>110</h></coordinates>
  <panel_attributes>lt=&lt;&lt;-</panel_attributes>
  <additional_attributes>300.0;10.0;10.0;90.0</additional_attributes>
</element>
<element>
