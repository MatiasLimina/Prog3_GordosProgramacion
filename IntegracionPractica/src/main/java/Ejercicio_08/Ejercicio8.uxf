<diagram program="umletino" version="15.1"><zoom_level>9</zoom_level>
<element>
  <id>UMLClass</id>
  <coordinates><x>50</x><y>50</y><w>220</w><h>140</h></coordinates>
  <panel_attributes>TipoAvion
--
- numeroModelo: String
- capacidad: int
- peso: double
- aviones: List&lt;Avion&gt;
- pilotosAutorizados: List&lt;Piloto&gt;
- mecanicosAutorizados: List&lt;Mecanico&gt;
--
</panel_attributes>
</element>

<element>
  <id>UMLClass</id>
  <coordinates><x>350</x><y>50</y><w>230</w><h>150</h></coordinates>
  <panel_attributes>Avion
--
- numeroMatricula: String {unique}
- tipoAvion: TipoAvion
- hangar: Hangar
- propietarios: List&lt;PropiedadAvion&gt;
- mantenimientos: List&lt;Servicio&gt;
--
</panel_attributes>
</element>

<element>
  <id>UMLClass</id>
  <coordinates><x>680</x><y>50</y><w>200</w><h>120</h></coordinates>
  <panel_attributes>Hangar
--
- numero: int
- capacidad: int
- ubicacion: String
- aviones: List&lt;Avion&gt;
--
</panel_attributes>
</element>

<element>
