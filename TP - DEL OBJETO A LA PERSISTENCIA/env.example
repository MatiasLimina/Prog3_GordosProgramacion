# Copiar a .env y completar con valores locales. NO commitear .env.
# La app, Alembic y el seed arman la URL de la base con las variables POSTGRES_*.

# --- Base de datos (obligatorias: POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB) ---
POSTGRES_USER=usuario
POSTGRES_PASSWORD=
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
# Si el 5432 esta ocupado en tu maquina, usar otro puerto (lo toman Docker y la app)
POSTGRES_PORT=5432

# --- Autenticacion ---
# OBLIGATORIA, minimo 32 caracteres. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Duracion del token en minutos (>= 1)
JWT_EXPIRE_MINUTES=60
# Costo de bcrypt (4 a 31)
BCRYPT_COST=12
# Maximo de llamadas a bcrypt al mismo tiempo (>= 1)
BCRYPT_MAX_CONCURRENTES=4
# true en produccion (HTTPS); en local se sirve por http
COOKIE_SECURE=false

# --- Motor de base ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true muestra en consola las consultas SQL emitidas
# (antes se llamaba DB_ECHO: ese nombre ya no se lee)
SQL_ECHO=false

# DATABASE_URL ya no se lee: se arma sola con POSTGRES_*.
# Tests: REQUIRE_TEST_DB=1 hace que la falta de la base libreria_test sea un fallo y no un
# skip. Se pasa por linea de comandos (REQUIRE_TEST_DB=1 pytest), no desde .env.
