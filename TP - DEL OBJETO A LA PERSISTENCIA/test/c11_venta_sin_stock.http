@host = http://localhost:8000
# Contraseñas de mentira del seed (seed.py); no son credenciales reales.
@passAdmin = admin-seed-1
@passVendedor = vendedor-seed-1

# C-11 · Venta sin stock suficiente: 409 y NINGUNA escritura (ni venta, ni descuento de Rayuela, ni movimientos).
# Antes de correr: `python seed.py`. Se corre de arriba abajo.

### Sesión del vendedor
# Esperado: 200
# @name loginVendedor
# @no-cookie-jar
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "vendedor@example.com", "password": "{{passVendedor}}" }

### Sesión del administrador (para ver los movimientos)
# Esperado: 200
# @name loginAdmin
# @no-cookie-jar
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "{{passAdmin}}" }

### Rayuela × 1 y Bestiario × 2 (de Bestiario queda 1)
# Esperado: 409 «Stock insuficiente para el libro 5: hay 1, se pidieron 2.»
# @no-cookie-jar
POST {{host}}/ventas/
Content-Type: application/json
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

{
  "cliente_id": 2,
  "renglones": [
    { "libro_id": 1, "cantidad": 1 },
    { "libro_id": 5, "cantidad": 2 }
  ]
}

### No quedó ninguna venta nueva
# Esperado: 200 total 1 (sólo la venta del seed).
# @no-cookie-jar
GET {{host}}/ventas/
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

### Rayuela no se descontó
# Esperado: 200 stock 10.
# @no-cookie-jar
GET {{host}}/libros/1

### Sus movimientos son sólo los dos del seed
# Esperado: 200 «Stock inicial» (+11) y la venta del seed (-1); ninguno más.
# @no-cookie-jar
GET {{host}}/libros/1/movimientos
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

# Control SQL: correr test/invariante_stock.sql con psql (ver su encabezado); sin diferencias en los cinco libros.
