@host = http://localhost:8000

### Crear editorial (se captura su id)
# @name editorial1
# Esperado: 201 {"id": ..., "nombre": "Planeta", "pais": "España"}
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "Planeta", "pais": "España"}

### Nombre repetido
# Esperado: 409 {"detail": "Ya existe una editorial con ese nombre."}
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "Planeta", "pais": "España"}

### Body inválido (nombre vacío)
# Esperado: 422
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "", "pais": "España"}

### Crear una segunda editorial (se captura su id)
# @name editorial2
# Esperado: 201
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "Sudamericana", "pais": "Argentina"}

### Listado paginado
# Esperado: 200 con lista (máximo 2 elementos, desde el segundo)
GET {{host}}/editoriales/?limit=2&offset=1

### Obtener por id
# Esperado: 200 con los datos de la primera editorial
GET {{host}}/editoriales/{{editorial1.response.body.id}}

### Id inexistente
# Esperado: 404 {"detail": "La editorial no existe."}
GET {{host}}/editoriales/999999999

### C-01: id no numérico
# Esperado: 422, sin ejecutar el handler
GET {{host}}/editoriales/abc

### PATCH parcial: sólo cambia el país, el nombre queda igual
# Esperado: 200 con nombre "Planeta" sin cambios y pais "México"
PATCH {{host}}/editoriales/{{editorial1.response.body.id}}
Content-Type: application/json

{"pais": "México"}

### PATCH con null explícito
# Esperado: 422 (los campos son NOT NULL; omitirlos sí es válido)
PATCH {{host}}/editoriales/{{editorial1.response.body.id}}
Content-Type: application/json

{"nombre": null}

### PATCH de la segunda editorial con el nombre de la primera
# Esperado: 409 {"detail": "Ya existe una editorial con ese nombre."}
PATCH {{host}}/editoriales/{{editorial2.response.body.id}}
Content-Type: application/json

{"nombre": "Planeta"}

### PATCH de editorial inexistente
# Esperado: 404
PATCH {{host}}/editoriales/999999999
Content-Type: application/json

{"pais": "X"}

### Crear género
# Esperado: 201 {"id": ..., "nombre": "Novela"}
POST {{host}}/generos/
Content-Type: application/json

{"nombre": "Novela"}

### Género repetido
# Esperado: 409 {"detail": "Ya existe un género con ese nombre."}
POST {{host}}/generos/
Content-Type: application/json

{"nombre": "Novela"}

### Listado de géneros paginado
# Esperado: 200
GET {{host}}/generos/?limit=10&offset=0

### Género para los libros (se captura su id)
# @name generoLibros
# Esperado: 201
POST {{host}}/generos/
Content-Type: application/json

{"nombre": "Ensayo"}

### Libro de la primera editorial con género (se captura su id)
# @name libroConGenero
# Esperado: 201 con editorial, género y autores []
POST {{host}}/libros/
Content-Type: application/json

{"isbn": "978-0-00-000001-0", "titulo": "Libro A", "precio": "1500.00", "stock": 3, "editorial_id": {{editorial1.response.body.id}}, "genero_id": {{generoLibros.response.body.id}}}

### Libros de una editorial
# Esperado: 200 con la lista de libros de la primera editorial (cada uno con editorial y género)
GET {{host}}/editoriales/{{editorial1.response.body.id}}/libros?limit=10&offset=0

### Libros de una editorial sin libros
# Esperado: 200 []
GET {{host}}/editoriales/{{editorial2.response.body.id}}/libros

### Libros de una editorial inexistente
# Esperado: 404 {"detail": "La editorial no existe."}
GET {{host}}/editoriales/999999999/libros

### Libros de editorial con id no numérico
# Esperado: 422
GET {{host}}/editoriales/abc/libros

### Libros de un género
# Esperado: 200 con los libros de ese género (no aparecen los libros sin género)
GET {{host}}/generos/{{generoLibros.response.body.id}}/libros

### Libros de un género inexistente
# Esperado: 404 {"detail": "El género no existe."}
GET {{host}}/generos/999999999/libros

### Libros de género con id no numérico
# Esperado: 422
GET {{host}}/generos/abc/libros
