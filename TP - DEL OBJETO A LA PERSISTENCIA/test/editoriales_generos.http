@host = http://localhost:8000

### Crear editorial
# Esperado: 201 {"id": ..., "nombre": "Planeta", "pais": "España"}
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "Planeta", "pais": "España"}

### Nombre repetido (ejecutar dos veces la creación)
# Esperado: 409 {"detail": "Ya existe una editorial con ese nombre."}
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "Planeta", "pais": "España"}

### Body inválido (nombre vacío)
# Esperado: 422
POST {{host}}/editoriales/
Content-Type: application/json

{"nombre": "", "pais": "España"}

### Listado paginado
# Esperado: 200 con lista (máximo 2 elementos, desde el segundo)
GET {{host}}/editoriales/?limit=2&offset=1

### Obtener por id
# Esperado: 200
GET {{host}}/editoriales/1

### Id inexistente
# Esperado: 404 {"detail": "La editorial no existe."}
GET {{host}}/editoriales/99999

### C-01: id no numérico
# Esperado: 422, sin ejecutar el handler
GET {{host}}/editoriales/abc

### PATCH parcial: sólo cambia el país, el nombre queda igual
# Esperado: 200 con nombre sin cambios y pais "México"
PATCH {{host}}/editoriales/1
Content-Type: application/json

{"pais": "México"}

### PATCH a un nombre que ya existe en otra editorial
# Esperado: 409 {"detail": "Ya existe una editorial con ese nombre."}
PATCH {{host}}/editoriales/2
Content-Type: application/json

{"nombre": "Planeta"}

### PATCH de editorial inexistente
# Esperado: 404
PATCH {{host}}/editoriales/99999
Content-Type: application/json

{"pais": "X"}

### Crear género
# Esperado: 201 {"id": ..., "nombre": "Novela"}
POST {{host}}/generos/
Content-Type: application/json

{"nombre": "Novela"}

### Género repetido
# Esperado: 409 {"detail": "Ya existe un género con ese nombre."}
POST {{host}}/generos/
Content-Type: application/json

{"nombre": "Novela"}

### Listado de géneros paginado
# Esperado: 200
GET {{host}}/generos/?limit=10&offset=0
